---
import { locales, localeNames, defaultLocale, t, type Locale } from '../i18n/ui';
const { locale = 'en', title, path = '' } = Astro.props as { locale: Locale; title: string; path?: string };
const href = (l: Locale) => (l === defaultLocale ? `/${path}` : `/${l}/${path}`).replace(/\/+$/, '') || '/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {locales.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href('en')} />
  </head>
  <body>
    <header class="top">
      <div class="left">
        <a class="brand" href={locale === defaultLocale ? '/' : `/${locale}/`}>◆ {t(locale, 'site.title')}</a>
        <nav class="sections">
          <a href={locale === defaultLocale ? '/' : `/${locale}/`}>{t(locale, 'nav.home')}</a>
          <a href={locale === defaultLocale ? '/trends' : `/${locale}/trends`}>{t(locale, 'nav.trends')}</a>
        </nav>
      </div>
      <nav class="langs">
        {locales.map((l) => <a class={l === locale ? 'on' : ''} href={href(l)}>{localeNames[l]}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div>{t(locale, 'footer.method')}</div>
      <div>{t(locale, 'footer.source')}</div>
    </footer>
    <style is:global>
      :root { --bg:#0d1117; --card:#161b22; --bd:#21262d; --tx:#e6edf3; --mut:#8b949e; --ac:#7c5cff; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--tx); font-family: -apple-system,'Segoe UI',Roboto,'PingFang TC','Microsoft JhengHei',sans-serif; line-height: 1.55; }
      main { max-width: 1080px; margin: 0 auto; padding: 24px 20px 60px; }
      a { color: inherit; }
      .top { max-width: 1080px; margin: 0 auto; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-bottom: 1px solid var(--bd); }
      .left { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
      .brand { font-weight: 700; text-decoration: none; font-size: 16px; }
      .sections { display: flex; gap: 14px; }
      .sections a { font-size: 13px; color: var(--mut); text-decoration: none; }
      .sections a:hover { color: var(--tx); }
      .langs { display: flex; gap: 4px; flex-wrap: wrap; }
      .langs a { font-size: 12px; color: var(--mut); text-decoration: none; padding: 3px 8px; border-radius: 14px; border: 1px solid transparent; }
      .langs a.on { color: var(--tx); border-color: var(--ac); }
      /* chart islands sit in fixed-height wrappers; override Astro's default display:contents
         so Chart.js can measure a real parent height */
      astro-island { display: block !important; height: 100% !important; }
      .card { background: var(--card); border: 1px solid var(--bd); border-radius: 14px; padding: 18px 20px; margin-bottom: 20px; }
      .card h2 { margin: 0 0 4px; font-size: 16px; }
      .card .desc { color: var(--mut); font-size: 13px; margin: 0 0 14px; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
      @media (max-width: 760px) { .grid2 { grid-template-columns: 1fr; } }
      .foot { max-width: 1080px; margin: 0 auto; padding: 24px 20px; color: var(--mut); font-size: 12px; border-top: 1px solid var(--bd); }
      .badge { display: inline-block; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600; }
      .b-evergreen { background: #2ea04322; color: #3fb950; } .b-rising { background: #7c5cff22; color: #a78bfa; }
      .b-steady { background: #d2992222; color: #d29922; } .b-dormant { background: #8b949e22; color: #8b949e; }
    </style>
  </body>
</html>
