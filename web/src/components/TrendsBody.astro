---
import { languageTrends, devToolAdoption } from '../lib/trends';
import { repos } from '../lib/data';
import { t, type Locale } from '../i18n/ui';
import LangTrends from './charts/LangTrends.tsx';
import MonthlyBar from './charts/MonthlyBar.tsx';
const { locale = 'en' } = Astro.props as { locale: Locale };
const { years, languages } = languageTrends();
const aiSeries = years.map((y) => ({ m: String(y.year), c: y.aiAdoptionPct }));
const tools = devToolAdoption();
const toolMax = tools.tools[0]?.count || 1;
---
<h1 style="font-size:26px;margin:18px 0 6px">{t(locale, 'trends.heading')}</h1>
<p style="color:var(--mut);margin:0 0 24px">{t(locale, 'trends.intro', { count: repos.length })}</p>

<div class="card">
  <h2>{t(locale, 'trends.lang.title')}</h2>
  <p class="desc">{t(locale, 'trends.lang.desc')}</p>
  <div style="height:300px"><LangTrends client:only="react" years={years} languages={languages} /></div>
</div>

<div class="card">
  <h2>{t(locale, 'trends.ai.title')}</h2>
  <p class="desc">{t(locale, 'trends.ai.desc')}</p>
  <div style="height:170px"><MonthlyBar client:only="react" data={aiSeries} color="#3fb950" /></div>
</div>

{tools.scanned > 0 && (
  <div class="card">
    <h2>{t(locale, 'trends.tools.title')}</h2>
    <p class="desc">{t(locale, 'trends.tools.desc', { withAI: tools.withAI, scanned: tools.scanned })}</p>
    {tools.tools.map((tool) => (
      <div class="bar-row">
        <div class="bn">{tool.name}</div>
        <div class="bt"><div class="bf" style={`width:${(100 * tool.count) / toolMax}%`}></div></div>
        <div class="bv">{tool.count} · {tool.pct}%</div>
      </div>
    ))}
    <p class="desc" style="margin-top:12px">{t(locale, 'trends.tools.editors')}: {tools.editors.map((e) => `${e.name} (${e.count})`).join(' · ')}</p>
  </div>
)}

<div class="card" style="padding:0;overflow:hidden">
  <table>
    <thead><tr>
      <th>{t(locale, 'trends.table.year')}</th><th class="n">{t(locale, 'trends.table.repos')}</th>
      <th>{t(locale, 'trends.table.topLang')}</th><th class="n">{t(locale, 'trends.table.ai')}</th>
    </tr></thead>
    <tbody>
      {years.map((y) => (
        <tr>
          <td>{y.year}</td><td class="n">{y.count}</td>
          <td>{y.topLang}</td><td class="n">{y.aiAdoptionPct}%</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 10px 14px; border-bottom: 1px solid var(--bd); text-align: left; }
  th { color: var(--mut); font-weight: 600; font-size: 12px; }
  .n { text-align: right; font-variant-numeric: tabular-nums; }
  .bar-row { display: flex; align-items: center; gap: 10px; margin: 7px 0; font-size: 13px; }
  .bn { width: 150px; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bt { flex: 1; background: #1b2230; border-radius: 5px; height: 14px; overflow: hidden; }
  .bf { height: 100%; background: linear-gradient(90deg, #7c5cff, #a78bfa); border-radius: 5px; }
  .bv { width: 90px; flex: none; text-align: right; color: var(--mut); font-variant-numeric: tabular-nums; }
</style>
