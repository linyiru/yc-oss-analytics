---
import '../styles/ds.css';
import '../styles/app.css';
import MethodologyPage from '../components/MethodologyPage.jsx';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Methodology · oss/signal</title>
    <meta name="description" content="How oss/signal computes every metric — and its known limitations." />
    <script is:inline>try { document.documentElement.setAttribute('data-theme', localStorage.getItem('ycoss-theme') || 'dark'); } catch (e) {}</script>
  </head>
  <body><MethodologyPage client:only="react" /></body>
</html>
