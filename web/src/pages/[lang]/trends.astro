---
import Base from '../../layouts/Base.astro';
import TrendsBody from '../../components/TrendsBody.astro';
import { locales, t, defaultLocale } from '../../i18n/ui';
export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as any;
---
<Base locale={lang} title={`Trends · ${t(lang, 'site.title')}`} path="trends">
  <TrendsBody locale={lang} />
</Base>
