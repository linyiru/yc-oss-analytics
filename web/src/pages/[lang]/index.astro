---
import Base from '../../layouts/Base.astro';
import HomeBody from '../../components/HomeBody.astro';
import { locales, t, defaultLocale } from '../../i18n/ui';
export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as any;
---
<Base locale={lang} title={t(lang, 'site.title')} path="">
  <HomeBody locale={lang} />
</Base>
