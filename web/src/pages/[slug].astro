---
import '../styles/ds.css';
import '../styles/app.css';
import RepoPage from '../components/RepoPage.jsx';
import { repos } from '../lib/data';
import { toRepoView } from '../lib/repoView';
export function getStaticPaths() {
  return repos.map((r) => ({ params: { slug: r.slug }, props: { view: toRepoView(r.slug) } }));
}
const { view } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{view.c.name} · oss/signal</title>
    <meta name="description" content={view.c.oneLiner} />
    <script is:inline>
      try { document.documentElement.setAttribute('data-theme', localStorage.getItem('ycoss-theme') || 'dark'); } catch (e) {}
    </script>
  </head>
  <body>
    <RepoPage client:only="react" view={view} />
  </body>
</html>
