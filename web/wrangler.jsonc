{
  // Cloudflare Pages — static Astro site served at yc-oss-analytics.pages.dev (root).
  // Fully static (output: 'static') -> no adapter needed.
  // Deploy:  pnpm run deploy   (runs: astro build && wrangler pages deploy ./dist)
  // First time:  wrangler login   then   wrangler pages project create yc-oss-analytics
  "name": "yc-oss-analytics",
  "compatibility_date": "2026-06-06",
  "pages_build_output_dir": "./dist"
}
